{
  "name": "turri-app",
  "version": "0.1.15",
  "private": true,
  "description": "A proof of concept: turri as a native desktop app, for people who do not live in a terminal.",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "postinstall": "node scripts/brand.mjs && node scripts/pty.mjs",
    "brand": "node scripts/brand.mjs",
    "icon": "electron scripts/icon.cjs && node scripts/brand.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:npm": "TURRI_DEV=npm node scripts/dev.mjs",
    "build": "node scripts/build.mjs && vite build",
    "start": "npm run build && electron .",
    "dist": "node scripts/pty.mjs && npm run build && electron-builder --publish never",
    "dist:dir": "node scripts/pty.mjs && npm run build && electron-builder --dir --publish never",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && playwright test",
    "release": "node scripts/pty.mjs && npm run build && electron-builder --publish always"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@turri-dev/cli": "0.1.27",
    "@xterm/headless": "^6.0.0",
    "electron-updater": "^6.8.9",
    "node-pty": "1.1.0"
  },
  "license": "MIT",
  "homepage": "https://github.com/turri-oss/turri-desktop"
}
